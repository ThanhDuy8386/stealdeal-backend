{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "StealDeal.Identity",
    "Audience": "StealDeal.Client",
    "Secret": "CHANGE_THIS_TO_A_LONG_SECRET_AT_LEAST_32_CHARACTERS",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "ConnectionStrings": {
    "PaymentDb": "Server=localhost;Database=StealDealPaymentDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest"
  },
  "Outbox": {
    "BatchSize": 20,
    "PollingIntervalSeconds": 10,
    "MaxRetryCount": 5
  },
  "VnPay": {
    "TmnCode": "YOUR_VNPAY_TMN_CODE",
    "HashSecret": "YOUR_VNPAY_HASH_SECRET",
    "PaymentUrl": "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html",
    "ReturnUrl": "https://localhost:7080/api/vnpay/return",
    "IpNUrl": "https://localhost:7080/api/vnpay/ipn",
    "Version": "2.1.0",
    "Command": "pay",
    "CurrCode": "VND",
    "Locale": "vn",
    "ExpireMinutes": 15
  }
}
