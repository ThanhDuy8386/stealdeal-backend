{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "StealDeal.Identity",
    "Audience": "StealDeal.Client",
    "Secret": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "ConnectionStrings": {
    "PaymentDb": "Server=localhost;Database=StealDealPaymentDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest"
  },
  "Outbox": {
    "BatchSize": 20,
    "PollingIntervalSeconds": 10,
    "MaxRetryCount": 5
  },
  "InventoryReservedConsumer": {
    "ExchangeName": "stealdeal.events",
    "ExchangeType": "topic",
    "QueueName": "payment.inventory-reserved",
    "BindingKey": "inventory.reserved",
    "PrefetchCount": 10
  },
  "PaymentExpiration": {
    "Enabled": true,
    "BatchSize": 20,
    "PollingIntervalSeconds": 30
  },
  "VnPay": {
    "TmnCode": "",
    "HashSecret": "",
    "PaymentUrl": "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html",
    "ReturnUrl": "https://stealdeal.store/payment/vnpay-return",
    "IpNUrl": "https://stealdeal.store/api/payment/vnpay/ipn",
    "Version": "2.1.0",
    "Command": "pay",
    "CurrCode": "VND",
    "Locale": "vn",
    "ExpireMinutes": 10
  }
}
