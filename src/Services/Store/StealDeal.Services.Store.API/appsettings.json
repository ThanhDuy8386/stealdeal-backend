{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "StealDeal.Identity",
    "Audience": "StealDeal.Client",
    "Secret": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "ConnectionStrings": {
    "StoreDb": "Server=localhost;Database=StealDealStoreDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest"
  },
  "Outbox": {
    "BatchSize": 20,
    "PollingIntervalSeconds": 10,
    "MaxRetryCount": 5
  },
  "OrderCreatedConsumer": {
    "ExchangeName": "stealdeal.events",
    "ExchangeType": "topic",
    "QueueName": "store.order.created",
    "BindingKey": "order.created",
    "PrefetchCount": 10
  },
  "InventoryReleaseRequestedConsumer": {
    "ExchangeName": "stealdeal.events",
    "ExchangeType": "topic",
    "QueueName": "store.inventory-release-requested",
    "BindingKey": "inventory.release_requested",
    "PrefetchCount": 10
  },
  "Aws": {
    "Region": "ap-southeast-1",
    "PublicBucketName": "stealdeals-public-assets",
    "AccessKeyId": "",
    "SecretAccessKey": ""
  },
  "Services": {
    "OrderServiceUrl": "http://localhost:5165"
  },
  "Geoapify": {
    "BaseUrl": "https://api.geoapify.com",
    "ApiKey": "",
    "TimeoutSeconds": 10,
    "CacheMinutes": 5
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "SessionTtlMinutes": 30,
    "MaxRecentTurns": 10
  },
  "Gemini": {
    "ApiKey": "",
    "Model": "gemini-3.5-flash-lite",
    "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/",
    "Temperature": 0.3,
    "MaxOutputTokens": 1024,
    "SystemInstruction": "You are StealDeal Shopping Assistant, a helpful and friendly AI assistant for the StealDeal platform. You help buyers discover surprise bags, understand store pickup windows, and answer questions about food categories. Keep your answers concise, friendly, and focused on helping the user find deals. Do not promise discounts or execute orders directly."
  }
}
