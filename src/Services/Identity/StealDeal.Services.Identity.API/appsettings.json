{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "StealDeal.Identity",
    "Audience": "StealDeal.Client",
    "Secret": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "ConnectionStrings": {
    "IdentityDb": "Server=localhost;Database=StealDealIdentityDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest"
  },
  "Outbox": {
    "BatchSize": 20,
    "PollingIntervalSeconds": 10,
    "MaxRetryCount": 5
  },
  "StoreVerifiedConsumer": {
    "ExchangeName": "stealdeal.events",
    "ExchangeType": "topic",
    "QueueName": "identity.store-verified",
    "BindingKey": "store.verified",
    "PrefetchCount": 10,
    "ReconnectDelaySeconds": 10,
    "MaxRetryCount": 5
  },
  "Aws": {
    "Region": "ap-southeast-1",
    "PublicBucketName": "stealdeals-public-assets",
    "AccessKeyId": "",
    "SecretAccessKey": ""
  }
}
